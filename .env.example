# Environment Settings
ENVIRONMENT=production
DEBUG=False
APP_NAME="Hybrid Telegram Bot & Support System"
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_32_character_string

# Access Token Expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Railway PostgreSQL URL (e.g., postgresql://postgres:pass@roundhouse.proxy.rlwy.net:12345/railway)
DATABASE_URL=sqlite+aiosqlite:///./support_db.sqlite

# Redis Configuration (Optional, fallback in-memory if unavailable)
# Railway Redis URL (e.g., redis://default:pass@redis.railway.internal:6379)
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (Comma-separated list or JSON array)
# Set to your frontend Railway URL in production
CORS_ORIGINS=["https://your-frontend.up.railway.app","http://localhost:3000"]

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_token
STAFF_GROUP_ID=-100123456789

# AI Assistant Integration
AI_PROVIDER=auto
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-1.5-flash
